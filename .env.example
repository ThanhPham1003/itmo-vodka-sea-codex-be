# Reference only: Viper does not automatically load .env files.
# Copy into an ignored local configuration, or export these variables yourself.
HTTP_SERVER_HOST=127.0.0.1
HTTP_SERVER_PORT=8080
HTTP_SERVER_MODE=release
HTTP_SERVER_LOG_LEVEL=info
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=sea_codex
POSTGRES_PASSWORD=
POSTGRES_DBNAME=sea_codex
POSTGRES_SSLMODE=disable
POSTGRES_CONNECT_TIMEOUT=5s
AUTH_PRIVATE_KEY_HEX=
AUTH_PUBLIC_KEY_HEX=
AUTH_TOKEN_DURATION=24h

# Enable on the first controlled startup to create application tables.
POSTGRES_AUTO_MIGRATE=false
AUTH_REQUEST_LIMIT=20
AUTH_RATE_WINDOW=1m
UPLOADS_MAX_FILE_SIZE_MB=20
UPLOADS_MAX_FILES_PER_REQUEST=10
UPLOADS_MAX_PDF_PAGES=100
PROCESSING_ENABLED=false
PROCESSING_PROVIDER=openai-compatible
PROCESSING_BASE_URL=https://api.openai.com
PROCESSING_API_KEY=
PROCESSING_MODEL=
PROCESSING_POLL_INTERVAL=2s
PROCESSING_MAX_CONCURRENT_FILES=3
PROCESSING_TIMEOUT=90s
PROCESSING_LEASE_DURATION=5m
PROCESSING_MAX_PAGE_DIMENSION=1600

# Product-help chatbot; never expose this key in the frontend.
ASSISTANT_ENABLED=false
ASSISTANT_BASE_URL=https://api.openai.com
ASSISTANT_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT=30s
ASSISTANT_MAX_OUTPUT_TOKENS=1500
ASSISTANT_REQUEST_LIMIT=10
ASSISTANT_RATE_WINDOW=1m
ASSISTANT_MAX_CONCURRENT_REQUESTS=4
